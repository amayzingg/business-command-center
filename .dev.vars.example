# Copy this file to .dev.vars (git-ignored) for LOCAL testing: `npm run dev:worker`
# reads it, and `npm run secrets:push` uploads it to your Cloudflare Worker.
# Never commit .dev.vars, never put keys in src/, never paste keys into chat.
#
# More private for real (live) accounts: skip this file and type the key only in the
# Cloudflare dashboard, so it never sits on your computer where AI tools can read it.
# See REAL-DATA.md → "Where your keys live".
#
# Keep only the lines you use. secrets:push uploads every KEY=value line here.

# Stripe dashboard → Test mode → Developers → API keys → Secret key
STRIPE_SECRET_KEY=sk_test_replace_me

# Optional, for the weekly email (not needed if you use Cloudflare Email):
# resend.com → API Keys → Create (Sending access)
RESEND_API_KEY=re_replace_me

# Optional, private Google Sheet (see GOOGLE-SHEETS.md). From the service account's JSON
# key: client_email and private_key (one line, in double quotes, keep the \n's).
GOOGLE_SA_EMAIL=dashboard-reader@your-project.iam.gserviceaccount.com
GOOGLE_SA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_me\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=replace_me

# Optional, Google Search Console + GA4 (see GOOGLE-ANALYTICS.md; reuses the service account above)
GSC_SITE_URL=sc-domain:yourdomain.com
GA4_PROPERTY_ID=123456789
