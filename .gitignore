node_modules
dist
.wrangler
.env
.env.*
.DS_Store

# Keys: one .dev.vars at the root (copied into email-worker/ by npm run email:dev)
.dev.vars*
!.dev.vars.example
# Real bank exports stay on your machine (the fake sample is fine)
data/*.csv
!data/*.sample.csv

# Imported bank data is real: never commit it (the fictional bank.sample.json is tracked)
src/data/bank.json
# Generated at deploy time from bank.json or bank.sample.json
email-worker/.generated/

# Google service account key files (copy the values into .dev.vars, then delete the file)
*service-account*.json
*serviceaccount*.json
*-sa-key*.json
gcp-key*.json
secrets/
